{
  "system_name": "AccessControl-Door-v3-FIXED",
  "description": "Phien ban DA SUA TOAN DIEN: loai bo canh glitch, sua cam bien tamper tro den S4, bo sung thuoc tinh an toan loai tru P4 va reachability P5.",
  "atomic_propositions": ["locked", "unlocked", "alarm", "authenticated", "tamper"],
  "states": [
    {"id": "S0", "name": "Locked_Idle",         "labels": ["locked"]},
    {"id": "S1", "name": "Authenticating",       "labels": ["locked"]},
    {"id": "S2", "name": "Authenticated_Unlock", "labels": ["unlocked", "authenticated"]},
    {"id": "S3", "name": "Locked_Alarm",         "labels": ["locked", "alarm"]},
    {"id": "S4", "name": "TamperDetected_Alarm", "labels": ["locked", "alarm", "tamper"]}
  ],
  "initial_states": ["S0"],
  "transitions": [
    {"from": "S0", "event": "insert_card",         "to": "S1"},
    {"from": "S1", "event": "auth_success",         "to": "S2"},
    {"from": "S1", "event": "auth_fail",            "to": "S0"},
    {"from": "S1", "event": "auth_fail_3rd_time",   "to": "S3"},
    {"from": "S1", "event": "timeout_reset",        "to": "S0"},
    {"from": "S2", "event": "door_closed_timeout",  "to": "S0"},
    {"from": "S3", "event": "operator_reset",       "to": "S0"},
    {"from": "S0", "event": "tamper_sensor",        "to": "S4"},
    {"from": "S4", "event": "operator_reset",       "to": "S0"}
  ],
  "properties_to_check": [
    {
      "id": "P1_SAFETY_NO_UNLOCK_WITHOUT_AUTH",
      "type": "AG_NOT",
      "formula": "unlocked AND NOT authenticated",
      "description": "Khong bao gio ton tai trang thai unlocked ma khong authenticated."
    },
    {
      "id": "P2_SAFETY_ALARM_ON_TAMPER",
      "type": "AG_IMPLIES",
      "formula": "tamper -> alarm",
      "description": "Moi khi phat hien tamper, he thong phai o trang thai bao dong (alarm)."
    },
    {
      "id": "P3_REACHABILITY_UNLOCK",
      "type": "EF",
      "formula": "unlocked",
      "description": "Ton tai it nhat mot duong di tu init den unlocked (tinh kha thi)."
    },
    {
      "id": "P4_SAFETY_MUTUAL_EXCLUSION_UNLOCK_ALARM",
      "type": "AG_NOT",
      "formula": "unlocked AND alarm",
      "description": "Khong bao gio dong thoi vua unlocked vua alarm (loai tru lan nhau)."
    },
    {
      "id": "P5_REACHABILITY_TAMPER_NO_VACUITY",
      "type": "EF",
      "formula": "tamper",
      "description": "Trang thai tamper phai dat duoc (tranh vacuous truth cho P2)."
    }
  ]
}
