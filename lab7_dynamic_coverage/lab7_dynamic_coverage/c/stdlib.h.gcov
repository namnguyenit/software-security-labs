        -:  757:
        -:  758:/* POSIX/BSD extensions in libmingwex.a; these should be exposed only on
        -:  759: * the basis of appropriate POSIX or BSD specific feature tests...
        -:  760: *
        -:  761: * mkstemp(3) function support; added per feature request #2003.
        -:  762: * POSIX wants _XOPEN_SOURCE >= 500, (implying _POSIX_C_SOURCE >= 200112L).
        -:  763: */
        -:  764:#if _POSIX_C_SOURCE >= 200112L
        -:  765:
        -:  766:__cdecl __MINGW_NOTHROW  int mkstemp (char *);
        -:  767:__cdecl __MINGW_NOTHROW  int __mingw_mkstemp (int, char *);
        -:  768:
        -:  769:/* On POSIX platforms, programmers may adopt an idiom such as:
        -:  770: *
        -:  771: *   if( mkstemp( template ) >= 0 )
        -:  772: *   { unlink( template );
        -:  773: *     . . .
        -:  774: *   }
        -:  775: *
        -:  776: * to ensure that a temporary file does NOT persist after it is
        -:  777: * closed; MS-Windows does not allow such use of unlink(2), while
        -:  778: * the file remains open.  Thus, MS-Windows programmers must take
        -:  779: * extra care, to close and unlink temporary files AFTER use, if
        -:  780: * similar behaviour is desired.
        -:  781: *
        -:  782: * To mitigate this MS-Windows limitation, we provide support for
        -:  783: * an alternative, MinGW specific idiom:
        -:  784: *
        -:  785: *   #include <fcntl.h>
        -:  786: *
        -:  787: *   _MKSTEMP_SETMODE( _O_TEMPORARY );
        -:  788: *   if( mkstemp( template ) >= 0 )
        -:  789: *   {
        -:  790: *     . . .
        -:  791: *   }
        -:  792: *
        -:  793: * to achieve a similar effect to that of the above POSIX idiom; the
        -:  794: * following macros are a MinGW specific extension, to facilite such
        -:  795: * use of _O_TEMPORARY, (in addition to the POSIX required attributes),
        -:  796: * when creating the temporary file.  Note that they require <fcntl.h>,
        -:  797: * which <stdlib.h> should NOT automatically include; we leave it to
        -:  798: * the user to explicitly include it, if using _MKSTEMP_SETMODE.
        -:  799: */
        -:  800:#define _MKSTEMP_INVOKE       0
        -:  801:#define _MKSTEMP_DEFAULT     _O_CREAT | _O_EXCL | _O_RDWR
        -:  802:#define _MKSTEMP_SETMODE(M) __mingw_mkstemp( _MKSTEMP_DEFAULT | (M), NULL )
        -:  803:
        -:  804:#ifndef _NO_OLDNAMES
        -:  805:#define MKSTEMP_SETMODE(M)  __mingw_mkstemp( _MKSTEMP_DEFAULT | (M), NULL )
        -:  806:#endif
        -:  807:
        -:  808:__CRT_ALIAS __LIBIMPL__(( FUNCTION = mkstemp ))
        -:  809:__cdecl __MINGW_NOTHROW  int mkstemp (char *__filename_template)
        -:  810:{ return __mingw_mkstemp( _MKSTEMP_INVOKE, __filename_template ); }
        -:  811:
        -:  812:#endif	/* _POSIX_C_SOURCE >= 200112L (for mkstemp()) */
        -:  813:
        -:  814:/* mkdtemp(3) function support: added as adjunct to feature request #2003.
        -:  815: * POSIX wants _XOPEN_SOURCE >= 700, (implying _POSIX_C_SOURCE >= 200809L).
        -:  816: */
        -:  817:#if _POSIX_C_SOURCE >= 200809L
        -:  818:
